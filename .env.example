# Absolute URL of the deployed site (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=https://example.com

# Newsletter: a URL that accepts POST {"email": "..."} as JSON and returns 2xx on success
# (e.g. a Klaviyo / Mailchimp / Shopify Customer API proxy). Leave empty to keep sign-up closed.
NEWSLETTER_ENDPOINT=

# Contact form: a URL that accepts POST {"name","email","message"} as JSON and returns 2xx.
CONTACT_ENDPOINT=

# Order tracking: a URL that accepts POST {"orderNumber","email"} as JSON and replies
# { "status": "...", "statusUrl": "https://..." } (404 when no order matches).
# E.g. a small service using the Shopify Admin / Customer Account API. Leave empty until orders open.
ORDER_LOOKUP_ENDPOINT=
